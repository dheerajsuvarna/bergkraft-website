---
// Accordion built on native <details>/<summary>: keyboard and screen-reader
// accessible without JavaScript. The shared `name` lets one item open at a time.
import { faq } from '../data/faq';
---
<section class="section section--tint" id="faq">
  <div class="container grid">
    <div class="side">
      <h2>Questions buyers ask first.</h2>
    </div>
    <div class="items">
      {faq.map((item, i) => (
        <details name="faq" open={i === 0}>
          <summary><h3>{item.q}</h3><span class="icon" aria-hidden="true"></span></summary>
          <div class="answer">
            {item.a.map((p) => <p>{p}</p>)}
            {item.link && <p><a class="link" href={item.link.href} rel="noopener">{item.link.label}</a></p>}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .side { grid-column: 1 / span 4; margin-bottom: var(--s-6); }
  .items { grid-column: 6 / -1; border-bottom: 2px solid var(--c-line); }
  details { border-top: 2px solid var(--c-line); }
  summary {
    display: flex; justify-content: space-between; align-items: center; gap: var(--s-5);
    padding-block: var(--s-5); cursor: pointer; list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary h3 { font-size: var(--t-h3); }
  summary:hover h3 { color: var(--c-indigo); text-decoration: underline; text-decoration-color: var(--c-marigold); text-decoration-thickness: 3px; text-underline-offset: 5px; }
  .icon { position: relative; flex: none; width: 1.1rem; height: 1.1rem; }
  .icon::before, .icon::after {
    content: ''; position: absolute; left: 0; top: 50%; width: 100%; height: 3px; background: var(--c-indigo);
    transition: transform var(--dur-fast) var(--ease);
  }
  .icon::after { transform: rotate(90deg); }
  details[open] .icon::after { transform: rotate(0); }
  .answer { display: grid; gap: var(--s-4); padding-bottom: var(--s-6); max-width: 44rem; color: var(--c-muted); }
  @media (max-width: 62rem) { .side, .items { grid-column: 1 / -1; } }
</style>
