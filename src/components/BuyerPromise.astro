---
// Signature section: a two-column ledger comparing who an intermediary works for.
// The left column describes a commission model in general terms and makes no
// claim about any particular business.
const rows = [
  { q: 'Who engages the intermediary?', a: 'Typically the supplier or exporter.', b: 'The buyer.' },
  { q: 'Who pays?', a: 'The seller, usually as commission on the sale.', b: 'The buyer, under a written services agreement.' },
  { q: 'What is the fee linked to?', a: 'The value of the transaction.', b: 'Defined work, plus verified savings against an agreed benchmark.' },
  { q: 'Whose interest shapes the comparison?', a: 'The represented seller’s offer is the starting point.', b: 'Several suitable suppliers are compared against your specification.' },
  { q: 'Who is the supply contract with?', a: 'Buyer and supplier.', b: 'Buyer and supplier. Bergkraft’s contract is with you, for services only.' },
];
---
<section class="section bg-botanical on-dark" id="approach">
  <div class="container">
    <div class="statement" data-reveal>
      <p class="eyebrow"><span>01</span> The Bergkraft difference</p>
      <h2>We don’t represent the supplier. <em>We represent your interests.</em></h2>
    </div>

    <div class="grid intro">
      <p class="big" data-reveal>We work for the buyer.<br />The buyer pays us.</p>
      <div class="text" data-reveal style="--delay:.1s">
        <p>
          Bergkraft’s services are commissioned and paid for by the buyer. Our supplier evaluation, price
          comparison and negotiation are undertaken in the buyer’s interest.
        </p>
        <p class="muted">
          Commission-based brokerage is a long-established and legitimate way to trade. It simply answers to a
          different principal. If you are the one buying, it is worth knowing which side of the table your
          intermediary sits on.
        </p>
      </div>
    </div>

    <div class="ledger" role="table" aria-label="Supplier-led brokerage compared with buyer-side procurement">
      <div class="row row--head" role="row">
        <span role="columnheader"><span class="visually-hidden">Question</span></span>
        <span role="columnheader">Supplier-led brokerage</span>
        <span role="columnheader" class="ours">Buyer-side procurement <b>Bergkraft</b></span>
      </div>
      {rows.map((r, i) => (
        <div class="row" role="row" data-reveal style={`--delay:${0.05 * i}s`}>
          <span role="rowheader" class="q">{r.q}</span>
          <span role="cell" class="a">{r.a}</span>
          <span role="cell" class="b ours">{r.b}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .statement { display: grid; gap: var(--s-5); max-width: 64rem; }
  .intro { margin-top: clamp(3rem, 7vw, 6rem); row-gap: var(--s-6); align-items: start; }
  .big {
    grid-column: 1 / span 6; font-family: var(--f-serif); font-style: italic; font-weight: 320;
    font-size: clamp(1.7rem, 1.2rem + 2.2vw, 3rem); line-height: 1.15; color: var(--c-brass-light);
  }
  .text { grid-column: 8 / span 5; display: grid; gap: var(--s-4); }

  .ledger { margin-top: clamp(3rem, 7vw, 6rem); border-top: 1px solid var(--c-ivory); }
  .row { display: grid; grid-template-columns: 1.1fr 1.2fr 1.5fr; border-bottom: 1px solid var(--c-line-on-dark); }
  .row > span { padding: var(--s-5) var(--s-5) var(--s-5) 0; }
  .row--head > span { font-size: var(--t-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-muted-on-dark); padding-block: var(--s-4); }
  .row--head b { color: var(--c-brass-light); font-weight: 600; margin-left: 0.5em; }
  .q { font-size: var(--t-sm); color: var(--c-muted-on-dark); }
  .a { color: var(--c-muted-on-dark); }
  .b { font-family: var(--f-serif); font-size: 1.2rem; line-height: 1.35; }
  .row > .ours { background: rgba(246, 241, 231, 0.05); padding-left: var(--s-5); border-left: 1px solid var(--c-brass-light); }

  @media (max-width: 52rem) {
    .big, .text { grid-column: 1 / -1; }
    .row--head { display: none; }
    .row { grid-template-columns: 1fr; padding-block: var(--s-4); }
    .row > span { padding: var(--s-1) 0; }
    .q { color: var(--c-brass-light); font-size: var(--t-xs); letter-spacing: 0.12em; text-transform: uppercase; }
    .a::before { content: 'Supplier-led: '; font-size: var(--t-sm); }
    .a { font-size: var(--t-sm); }
    .row > .ours { margin-top: var(--s-2); padding: var(--s-3) var(--s-4); }
  }
</style>
