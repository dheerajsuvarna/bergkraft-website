---
// Analytics consent. Google Analytics is not loaded until the visitor accepts.
// Both choices are presented with equal weight, and "Cookie settings" in the
// footer reopens this panel so the decision can be changed at any time.
import { site } from '../data/site';
import { t, path, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).consent;
---
<section class="consent" aria-label={d.aria} data-consent data-ga-id={site.ga4Id} hidden>
  <div class="text">
    <h2>{d.title}</h2>
    <p>{d.text} <a href={path(lang, '/cookies/')}>{d.policy}</a></p>
  </div>
  <div class="actions">
    <button type="button" class="btn" data-consent-choice="denied">{d.decline}</button>
    <button type="button" class="btn" data-consent-choice="granted">{d.accept}</button>
  </div>
</section>

<style>
  .consent {
    position: fixed; z-index: 150; left: var(--gutter); right: var(--gutter); bottom: var(--gutter);
    max-width: 44rem; margin-left: auto;
    background: var(--c-white); color: var(--c-ink); border: 2px solid var(--c-indigo); border-radius: 14px; box-shadow: 0 12px 30px rgba(20, 27, 74, 0.18);
    padding: var(--s-5); display: grid; grid-template-columns: 1fr auto; gap: var(--s-5); align-items: center;
  }
  .consent[hidden] { display: none; }
  h2 { font-size: 1.35rem; line-height: 1.1; margin-bottom: var(--s-2); }
  p { font-size: var(--t-sm); color: var(--c-muted); }
  .actions { display: flex; gap: var(--s-3); }
  /* Identical styling for both buttons: no nudging toward "Accept". */
  .actions .btn { min-width: 7rem; justify-content: center; }
  @media (max-width: 40rem) {
    .consent { grid-template-columns: 1fr; }
    .actions .btn { flex: 1; }
  }
</style>
