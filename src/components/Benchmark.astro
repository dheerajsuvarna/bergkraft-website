---
import SectionHead from './SectionHead.astro';

const method = [
  { t: 'Define', d: 'Product specifications and commercial terms are written down first.' },
  { t: 'Reference', d: 'Relevant market reference points are established for that product.' },
  { t: 'Compare', d: 'Suitable supplier quotations are obtained and compared like for like.' },
  { t: 'Agree', d: 'The benchmark is documented and agreed with the buyer before negotiation.' },
];
const references = {
  Rice: ['FAO rice market information', 'APEDA information', 'Comparable Indian supplier and exporter quotations'],
  Coffee: [
    'International Coffee Organization indicators',
    'ICE Arabica and Robusta futures',
    'Indian Coffee Board information',
    'Comparable Indian supplier and exporter quotations',
  ],
};
const factors = ['Grade and quality', 'Origin', 'Processing', 'Quantity', 'Packaging', 'Incoterm', 'Destination', 'Freight and insurance', 'Payment terms', 'Quotation date'];

// Illustrative example. All derived values are calculated here so the figures always add up.
const ex = { benchmark: 1000, negotiated: 975, quantity: 25, share: 0.2 };
const gross = (ex.benchmark - ex.negotiated) * ex.quantity;
const fee = gross * ex.share;
const retained = gross - fee;
const usd = (n: number) => `$${n.toLocaleString('en-US')}`;
---
<section class="section bg-ink on-dark" id="benchmark">
  <div class="container">
    <SectionHead index="04" label="Bergkraft Independent Procurement Benchmark" title="A saving only means something <em>if the starting point was agreed first.</em>" wide>
      <p>
        The Bergkraft Independent Procurement Benchmark (BIPB) is the documented reference price for your exact
        requirement. It is fixed with you before we negotiate, and it is the only basis on which a performance
        fee can be calculated.
      </p>
    </SectionHead>

    <ol class="method" role="list">
      {method.map((m, i) => (
        <li data-reveal style={`--delay:${0.08 * i}s`}>
          <span class="step">Step {i + 1}</span>
          <h3>{m.t}</h3>
          <p class="muted">{m.d}</p>
        </li>
      ))}
    </ol>

    <!-- Worked example -->
    <figure class="example" aria-labelledby="ex-title" data-reveal>
      <figcaption>
        <span id="ex-title" class="tag">Illustrative example</span>
        <span class="warn">Illustrative example only. Not an actual quotation, achieved saving or guaranteed outcome.</span>
      </figcaption>

      <div class="prices">
        <div>
          <span class="k">Agreed benchmark</span>
          <span class="fig"><span data-count={ex.benchmark} data-prefix="$">{usd(ex.benchmark)}</span><small>/MT</small></span>
        </div>
        <span class="arrow" aria-hidden="true"></span>
        <div>
          <span class="k">Negotiated price</span>
          <span class="fig gold"><span data-count={ex.negotiated} data-prefix="$">{usd(ex.negotiated)}</span><small>/MT</small></span>
        </div>
        <div class="qty">
          <span class="k">Quantity</span>
          <span class="fig">{ex.quantity}<small> MT</small></span>
        </div>
      </div>

      <div class="split">
        <p class="k">Gross price difference: <strong>{usd(gross)}</strong> <span class="muted">({usd(ex.benchmark - ex.negotiated)} × {ex.quantity} MT)</span></p>
        <div class="bar" aria-hidden="true">
          <span class="keep" style={`flex:${1 - ex.share}`}></span>
          <span class="fee" style={`flex:${ex.share}`}></span>
        </div>
        <dl>
          <div>
            <dt>Buyer retains</dt>
            <dd><span data-count={retained} data-prefix="$">{usd(retained)}</span></dd>
          </div>
          <div class="right">
            <dt>Illustrative performance fee at {ex.share * 100}%</dt>
            <dd class="gold"><span data-count={fee} data-prefix="$">{usd(fee)}</span></dd>
          </div>
        </dl>
      </div>
    </figure>

    <div class="grid detail">
      <div class="refs" data-reveal>
        <h3>Reference points we draw on</h3>
        {Object.entries(references).map(([name, list]) => (
          <div class="ref">
            <h4>{name}</h4>
            <ul role="list">{list.map((r) => <li>{r}</li>)}</ul>
          </div>
        ))}
        <p class="note">
          These are reference points, not direct physical shipment prices. They show market level and direction.
          The benchmark itself is built from comparable quotations for your specification.
        </p>
      </div>

      <div class="factors" data-reveal style="--delay:.1s">
        <h3>A valid comparison accounts for</h3>
        <ul role="list">{factors.map((f) => <li>{f}</li>)}</ul>
        <p class="note">
          Savings cannot be claimed when they result from inferior quality, reduced specifications, a lower grade
          or general market movements unrelated to the agreed negotiation methodology.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .method { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--c-line-on-dark); }
  .method li { padding: var(--s-5) var(--s-5) var(--s-6) 0; display: grid; gap: var(--s-2); align-content: start; }
  .method li + li { border-left: 1px solid var(--c-line-on-dark); padding-left: var(--s-5); }
  .step, .k, h4 { font-size: var(--t-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-brass-light); font-weight: 560; font-family: var(--f-sans); }

  .example { margin-top: var(--s-8); border: 1px solid var(--c-brass-light); padding: clamp(1.5rem, 4vw, 3.5rem); }
  figcaption { display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-5); align-items: center; margin-bottom: var(--s-7); }
  .tag { background: var(--c-brass-light); color: var(--c-ink); font-size: var(--t-xs); font-weight: 620; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.3rem 0.7rem; }
  .warn { font-size: var(--t-sm); color: var(--c-muted-on-dark); }

  .prices { display: grid; grid-template-columns: auto 1fr auto auto; align-items: end; gap: var(--s-5) clamp(1.5rem, 4vw, 4rem); }
  .prices > div { display: grid; gap: var(--s-2); }
  .fig { font-family: var(--f-serif); font-weight: 300; font-size: clamp(2.6rem, 1.6rem + 5vw, 6rem); line-height: 0.95; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .fig small { font-family: var(--f-sans); font-size: 0.22em; letter-spacing: 0.08em; color: var(--c-muted-on-dark); margin-left: 0.3em; }
  .gold { color: var(--c-brass-light); }
  .arrow { height: 1px; background: var(--c-brass-light); margin-bottom: 1.4rem; position: relative; min-width: 2rem; }
  .arrow::after { content: ''; position: absolute; right: 0; top: -4px; width: 9px; height: 9px; border-top: 1px solid var(--c-brass-light); border-right: 1px solid var(--c-brass-light); transform: rotate(45deg); }
  .qty { padding-left: clamp(1.5rem, 4vw, 4rem); border-left: 1px solid var(--c-line-on-dark); }

  .split { margin-top: var(--s-7); padding-top: var(--s-5); border-top: 1px solid var(--c-line-on-dark); display: grid; gap: var(--s-4); }
  .split .k { text-transform: none; letter-spacing: 0; font-size: var(--t-base); color: var(--c-ivory); font-weight: 400; }
  .bar { display: flex; height: 0.75rem; gap: 3px; }
  .keep { background: var(--c-ivory); }
  .fee { background: var(--c-brass-light); }
  :global(.js) .example .bar { transform-origin: left; transform: scaleX(0); transition: transform 1.2s var(--ease) 0.3s; }
  :global(.js) .example.is-visible .bar { transform: none; }
  .split dl { display: flex; justify-content: space-between; gap: var(--s-5); }
  .split dt { font-size: var(--t-sm); color: var(--c-muted-on-dark); }
  .split dd { font-family: var(--f-serif); font-size: clamp(1.75rem, 1.2rem + 2vw, 3rem); line-height: 1.1; font-variant-numeric: tabular-nums; }
  .right { text-align: right; }

  .detail { margin-top: var(--s-8); row-gap: var(--s-7); }
  .refs { grid-column: 1 / span 6; display: grid; gap: var(--s-5); align-content: start; }
  .factors { grid-column: 8 / span 5; display: grid; gap: var(--s-5); align-content: start; }
  .ref { display: grid; grid-template-columns: 6rem 1fr; padding-top: var(--s-4); border-top: 1px solid var(--c-line-on-dark); }
  .ref li { padding-bottom: var(--s-2); }
  .factors ul { columns: 2; column-gap: var(--s-5); }
  .factors li { padding-block: var(--s-2); border-top: 1px solid var(--c-line-on-dark); break-inside: avoid; }

  @media (max-width: 62rem) {
    .method { grid-template-columns: repeat(2, 1fr); }
    .method li:nth-child(3) { border-left: 0; padding-left: 0; }
    .method li:nth-child(n + 3) { border-top: 1px solid var(--c-line-on-dark); }
    .refs, .factors { grid-column: 1 / -1; }
    .prices { grid-template-columns: 1fr 1fr; }
    .arrow { display: none; }
    .qty { grid-column: 1 / -1; padding-left: 0; border-left: 0; padding-top: var(--s-4); border-top: 1px solid var(--c-line-on-dark); }
    .qty .fig { font-size: 2.25rem; }
  }
  @media (max-width: 36rem) {
    .method { grid-template-columns: 1fr; }
    .method li, .method li + li { border-left: 0; padding-left: 0; }
    .method li + li { border-top: 1px solid var(--c-line-on-dark); }
    .ref { grid-template-columns: 1fr; gap: var(--s-2); }
    .split dl { flex-direction: column; }
    .prices { grid-template-columns: 1fr; }
    .right { text-align: left; }
  }
</style>
