---
// The core promise: four steps, in order. Numbered because it is a sequence.
const steps = [
  {
    verb: 'Find',
    text: 'We search the Indian market for mills, estates and exporters that can supply your exact specification and volume, and bring you a shortlist.',
    get: 'A shortlist of suitable suppliers',
  },
  {
    verb: 'Vet',
    text: 'We check registrations, export records, facilities and samples, and tell you exactly what was checked and how.',
    get: 'A written report on each supplier',
  },
  {
    verb: 'Negotiate',
    text: 'We agree a price benchmark with you, compare offers on the same terms and negotiate with suppliers on your behalf.',
    get: 'Offers compared side by side',
  },
  {
    verb: 'Deliver',
    text: 'We coordinate samples, inspection, documents and shipment with the supplier and forwarder until the goods reach your port.',
    get: 'One contact from order to arrival',
  },
];
---
<section class="section section--indigo on-dark" id="what-we-do">
  <div class="container">
    <div class="section-intro">
      <h2>Everything between your enquiry and your delivery.</h2>
      <p class="lead">
        You do not need an office, a buyer or a contact in India. Send us your requirement and we run the
        whole process for you.
      </p>
    </div>

    <ol class="steps" role="list">
      {steps.map((s, i) => (
        <li>
          <span class="n" aria-hidden="true">{i + 1}</span>
          <h3>{s.verb}</h3>
          <p>{s.text}</p>
          <p class="get"><span>You get</span>{s.get}</p>
        </li>
      ))}
    </ol>

    <p class="contract muted">
      You generally sign the purchase contract directly with the supplier, so there is no hidden margin on
      the goods. Your agreement with Bergkraft covers our services only. Contractual and export
      responsibilities are agreed for each order.
    </p>
  </div>
</section>

<style>
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1.25rem, 2.5vw, 2.5rem); }
  li { display: grid; gap: var(--s-3); align-content: start; }
  .n {
    font-weight: 800; font-stretch: 75%; font-size: clamp(4rem, 2.5rem + 5vw, 7rem); line-height: 0.8;
    color: var(--c-marigold); margin-bottom: var(--s-2);
  }
  h3 { font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem); font-weight: 800; font-stretch: 75%; line-height: 1; }
  .get { margin-top: var(--s-2); padding-top: var(--s-3); border-top: 2px solid var(--c-line-on-dark); font-weight: 600; }
  .get span { display: block; font-size: var(--t-xs); font-weight: 400; color: var(--c-muted-on-dark); }
  .contract { margin-top: var(--s-8); max-width: 46rem; font-size: var(--t-sm); }

  @media (max-width: 62rem) { .steps { grid-template-columns: repeat(2, 1fr); row-gap: var(--s-7); } }
  @media (max-width: 34rem) {
    .steps { grid-template-columns: 1fr; }
    li { grid-template-columns: 3.5rem 1fr; column-gap: var(--s-4); }
    .n { grid-row: 1 / span 4; font-size: 4.5rem; }
    li > :not(.n) { grid-column: 2; }
  }
</style>
