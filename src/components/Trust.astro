---
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).trust;
const commitments = d.items;
---
<section class="section" id="trust">
  <div class="container grid">
    <div class="claim">
      <h2>{d.h2}</h2>
      <p class="lead">{d.lead}</p>
    </div>

    <ul class="list" role="list">
      {commitments.map((c) => (
        <li>
          <span class="tick" aria-hidden="true">&#10003;</span>
          <div>
            <h3>{c.t}</h3>
            <p class="muted">{c.d}</p>
          </div>
        </li>
      ))}
    </ul>

    <p class="limits">{d.limits}</p>
  </div>
</section>

<style>
  .grid { row-gap: var(--s-7); }
  .claim { grid-column: 1 / span 6; display: grid; gap: var(--s-5); align-content: start; }
  .claim h2 { font-size: clamp(2.75rem, 1.4rem + 6vw, 6rem); }
  .claim h2:lang(de) { font-size: clamp(2.5rem, 1.3rem + 4.6vw, 4.75rem); hyphens: auto; }
  .list { grid-column: 8 / -1; display: grid; gap: var(--s-5); }
  li { display: grid; grid-template-columns: 2.5rem 1fr; gap: var(--s-4); align-items: start; }
  .tick {
    display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: var(--radius);
    background: var(--c-marigold); color: var(--c-indigo-deep); font-weight: 800; font-size: 1.25rem;
  }
  h3 { margin-bottom: var(--s-1); }
  .limits { grid-column: 1 / span 7; font-size: var(--t-sm); color: var(--c-muted); border-left: 6px solid var(--c-tint); padding-left: var(--s-4); }

  @media (max-width: 62rem) { .claim, .list, .limits { grid-column: 1 / -1; } }
</style>
