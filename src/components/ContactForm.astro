---
// Enquiry form handled by Netlify Forms.
// - `data-netlify` lets Netlify detect the form in the built HTML at deploy time.
// - `netlify-honeypot` adds spam protection without a third-party CAPTCHA.
// - With JavaScript, interactions.ts submits in the background and shows a
//   success or error message. Without it, the form posts normally to the thank-you page.
// Both languages post to the same Netlify form; the hidden `language` field
// records which version was used. Field names stay in English on purpose.
import { site } from '../data/site';
import { t, path, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const c = d.contact;
---
<section class="section section--indigo on-dark" id="contact">
  <div class="container grid">
    <div class="intro">
      <h2>{c.h2}</h2>
      <p class="lead">{c.lead}</p>
      <dl class="direct">
        <div><dt>{c.email}</dt><dd><a class="link" href={`mailto:${site.email}`} data-track="contact_email">{site.email}</a></dd></div>
        {site.phones.map((p) => (
          <div><dt>{c.phones[p.office]}</dt><dd><a class="link" href={p.href} rel="noopener" data-track="contact_whatsapp">{p.display}</a></dd></div>
        ))}
      </dl>
    </div>

    <div class="panel">
      <form
        name="sourcing-enquiry" method="POST" action={path(lang, '/thank-you/')} data-netlify="true" netlify-honeypot="bot-field" novalidate
        data-enquiry-form
        data-msg-required={c.msg.required} data-msg-checkbox={c.msg.checkbox} data-msg-email={c.msg.email}
        data-msg-one={c.msg.one} data-msg-many={c.msg.many} data-msg-failed={c.msg.failed}
        data-label-submit={c.submit} data-label-sending={c.sending}
      >
        <input type="hidden" name="form-name" value="sourcing-enquiry" />
        <input type="hidden" name="language" value={lang} />
        <p class="hp"><label>{c.honeypot} <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

        <div class="status" role="alert" data-form-error hidden></div>

        <fieldset>
          <legend>{c.legendYou}</legend>
          <div class="field"><label for="f-name">{c.f.name}</label><input id="f-name" name="name" autocomplete="name" required /></div>
          <div class="field"><label for="f-role">{c.f.role}</label><input id="f-role" name="role" autocomplete="organization-title" required /></div>
          <div class="field"><label for="f-company">{c.f.company}</label><input id="f-company" name="company" autocomplete="organization" required /></div>
          <div class="field"><label for="f-website">{c.f.website}</label><input id="f-website" name="website" type="text" inputmode="url" autocomplete="url" placeholder="example.com" required /></div>
          <div class="field"><label for="f-email">{c.f.email}</label><input id="f-email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="f-phone">{c.f.phone} <span class="opt">{d.ui.optional}</span></label><input id="f-phone" name="phone" type="tel" autocomplete="tel" /></div>
          <div class="field"><label for="f-country">{c.f.country}</label><input id="f-country" name="country" autocomplete="country-name" required /></div>
        </fieldset>

        <fieldset>
          <legend>{c.legendReq}</legend>
          <div class="field">
            <label for="f-product">{c.f.product}</label>
            <select id="f-product" name="product" required>
              <option value="">{d.ui.select}</option>{c.productOptions.map((o) => <option>{o}</option>)}
            </select>
          </div>
          <div class="field"><label for="f-qty">{c.f.quantity}</label><input id="f-qty" name="quantity_mt" inputmode="decimal" required /></div>
          <div class="field wide"><label for="f-spec">{c.f.specs}</label><textarea id="f-spec" name="specifications" rows="3" required></textarea></div>
          <div class="field"><label for="f-orders">{c.f.orders}</label><input id="f-orders" name="orders_per_year" inputmode="numeric" required /></div>
          <div class="field"><label for="f-dest">{c.f.destination}</label><input id="f-dest" name="destination" required /></div>
          <div class="field">
            <label for="f-pay">{c.f.payment}</label>
            <select id="f-pay" name="payment_terms" required>
              <option value="">{d.ui.select}</option>{c.paymentOptions.map((o) => <option>{o}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="f-time">{c.f.timeline}</label>
            <select id="f-time" name="timeline" required>
              <option value="">{d.ui.select}</option>{c.timelineOptions.map((o) => <option>{o}</option>)}
            </select>
          </div>
          <div class="field wide"><label for="f-more">{c.f.additional} <span class="opt">{d.ui.optional}</span></label><textarea id="f-more" name="additional" rows="3"></textarea></div>
        </fieldset>

        <!-- Consent is never pre-ticked. -->
        <label class="consent">
          <input type="checkbox" name="privacy_acknowledged" value="yes" required />
          <span>{c.consent[0]}<a href={path(lang, '/datenschutz/')}>{c.consent[1]}</a>{c.consent[2]}</span>
        </label>

        <button class="btn btn--primary" type="submit" data-submit>{c.submit}</button>
      </form>

      <div class="done" role="status" tabindex="-1" data-form-success hidden>
        <h3>{c.successTitle}</h3>
        <p>{c.successText}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .intro { grid-column: 1 / span 5; display: grid; gap: var(--s-5); align-content: start; }
  .direct { margin-top: var(--s-4); }
  .direct div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-1) var(--s-4); padding-block: var(--s-3); border-top: 2px solid var(--c-line-on-dark); }
  .direct dt { color: var(--c-muted-on-dark); }
  .direct dd { font-weight: 600; }

  .panel { grid-column: 7 / -1; background: var(--c-white); color: var(--c-ink); border-radius: 14px; padding: clamp(1.25rem, 3.5vw, 3rem); }
  fieldset { border: 0; padding: 0; margin: 0 0 var(--s-6); display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4) var(--s-5); }
  legend { font-size: var(--t-h3); font-weight: 800; font-stretch: 75%; color: var(--c-indigo); padding: 0; margin-bottom: var(--s-4); }
  .field { display: grid; gap: 0.35rem; align-content: start; }
  .wide { grid-column: 1 / -1; }
  label { font-size: var(--t-sm); font-weight: 600; }
  .opt { font-weight: 400; color: var(--c-muted); font-size: var(--t-xs); margin-left: 0.4em; }
  input:not([type='checkbox']), select, textarea {
    width: 100%; min-height: 3rem; padding: 0.6rem 0.75rem; background: var(--c-white);
    border: 2px solid var(--c-line); border-radius: var(--radius);
  }
  textarea { resize: vertical; }
  input:not([type='checkbox']):focus-visible, select:focus-visible, textarea:focus-visible { outline: 3px solid var(--c-marigold); outline-offset: 0; border-color: var(--c-indigo); }
  :global([aria-invalid='true']) { border-color: var(--c-error) !important; }
  :global(.field-error) { color: var(--c-error); font-size: var(--t-xs); font-weight: 600; }
  .hp { position: absolute; left: -9999px; }
  .consent { display: grid; grid-template-columns: auto 1fr; gap: var(--s-3); font-weight: 400; margin-bottom: var(--s-5); }
  .consent input { width: 1.35rem; height: 1.35rem; margin-top: 0.1rem; accent-color: var(--c-indigo); }
  .status { border: 2px solid var(--c-error); border-radius: var(--radius); color: var(--c-error); padding: var(--s-3) var(--s-4); margin-bottom: var(--s-5); font-size: var(--t-sm); font-weight: 600; }
  .done { display: grid; gap: var(--s-3); }
  .done[hidden], .status[hidden] { display: none; }
  .panel .btn--primary:hover { background: var(--c-indigo); border-color: var(--c-indigo); color: var(--c-white); }
  .panel .btn[disabled] { opacity: 0.6; cursor: progress; }
  .panel :global(:focus-visible) { outline-color: var(--c-indigo); }

  @media (max-width: 62rem) { .intro, .panel { grid-column: 1 / -1; } .panel { margin-top: var(--s-7); } }
  @media (max-width: 36rem) { fieldset { grid-template-columns: 1fr; } }
</style>
