---
// Sourcing categories, not a stock list. Each panel names the varieties we
// source and the details a buyer should state.
const products = [
  {
    name: 'Rice',
    intro: 'Basmati and non-Basmati rice from Indian mills and exporters.',
    groups: [
      { label: 'Basmati', items: ['1121 Sella', '1121 Raw', '1509 Basmati'] },
      { label: 'Non-Basmati', items: ['Sona Masoori', 'IR-64'] },
    ],
    specs: ['Grain length', 'Broken percentage', 'Moisture', 'Foreign matter', 'Processing', 'Crop year', 'Packaging', 'Quantity', 'Destination requirements'],
  },
  {
    name: 'Green coffee',
    intro: 'Arabica and Robusta from estates and curing works in Karnataka.',
    groups: [
      { label: 'Species', items: ['Indian Arabica', 'Indian Robusta'] },
      { label: 'Processing', items: ['Washed', 'Natural', 'Monsooned'] },
      { label: 'Origins', items: ['Coorg', 'Chikmagalur'] },
    ],
    specs: ['Screen size', 'Moisture', 'Defects', 'Processing', 'Cup profile', 'Origin', 'Packaging', 'Quantity'],
  },
];
---
<section class="section section--jute" id="products">
  <div class="container">
    <div class="section-intro">
      <h2>Rice and green coffee, sourced to your specification.</h2>
      <p class="lead">
        We do not hold stock or sell from a price list. Every order starts from what you need, and suppliers
        are found and compared against it.
      </p>
    </div>

    <div class="panels">
      {products.map((p) => (
        <article class="panel" id={p.name === 'Rice' ? 'rice' : 'coffee'}>
          <h3 class="name">{p.name}</h3>
          <p>{p.intro}</p>
          <dl>
            {p.groups.map((g) => (
              <div>
                <dt>{g.label}</dt>
                <dd>{g.items.join(', ')}</dd>
              </div>
            ))}
          </dl>
          <div class="specs">
            <h4>Tell us</h4>
            <ul role="list">{p.specs.map((s) => <li>{s}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .panels { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1rem, 2.4vw, 2.5rem); }
  .panel { background: var(--c-white); border-radius: 14px; padding: clamp(1.5rem, 3.5vw, 3rem); display: grid; gap: var(--s-5); align-content: start; }
  .name { font-family: var(--f-stencil); text-transform: uppercase; font-weight: 800; font-size: clamp(2.5rem, 1.6rem + 3.5vw, 4.25rem); line-height: 0.9; color: var(--c-indigo); }
  dl { display: grid; }
  dl div { display: grid; grid-template-columns: 8rem 1fr; gap: var(--s-4); padding-block: var(--s-3); border-top: 2px solid var(--c-tint); }
  dt { color: var(--c-muted); }
  dd { font-weight: 600; }
  h4 { font-size: var(--t-base); font-weight: 700; margin-bottom: var(--s-3); }
  .specs ul { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .specs li { background: var(--c-tint); border-radius: 999px; padding: 0.3rem 0.85rem; font-size: var(--t-sm); }

  @media (max-width: 56rem) { .panels { grid-template-columns: 1fr; } }
  @media (max-width: 26rem) { dl div { grid-template-columns: 1fr; gap: 0; } }
</style>
