---
import { t, type Lang } from '../i18n';
// Sourcing categories, not a stock list.
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).products;
const products = d.items;
---
<section class="section section--jute" id="products">
  <div class="container">
    <div class="section-intro">
      <h2>{d.h2}</h2>
      <p class="lead">{d.lead}</p>
    </div>

    <div class="panels">
      {products.map((p) => (
        <article class="panel" id={p.id}>
          <h3 class="name">{p.name}</h3>
          <p>{p.intro}</p>
          <dl>
            {p.groups.map((g) => (
              <div>
                <dt>{g.label}</dt>
                <dd>{g.items.join(', ')}</dd>
              </div>
            ))}
          </dl>
          <div class="specs">
            <h4>{d.tellUs}</h4>
            <ul role="list">{p.specs.map((s) => <li>{s}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .panels { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1rem, 2.4vw, 2.5rem); }
  .panel { background: var(--c-white); border-radius: 14px; padding: clamp(1.5rem, 3.5vw, 3rem); display: grid; gap: var(--s-5); align-content: start; }
  .name { font-family: var(--f-stencil); text-transform: uppercase; font-weight: 800; font-size: clamp(2.5rem, 1.6rem + 3.5vw, 4.25rem); line-height: 0.9; color: var(--c-indigo); overflow-wrap: anywhere; }
  dl { display: grid; }
  dl div { display: grid; grid-template-columns: 9rem 1fr; gap: var(--s-4); padding-block: var(--s-3); border-top: 2px solid var(--c-tint); }
  dt { color: var(--c-muted); }
  dd { font-weight: 600; }
  h4 { font-size: var(--t-base); font-weight: 700; margin-bottom: var(--s-3); }
  .specs ul { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .specs li { background: var(--c-tint); border-radius: 999px; padding: 0.3rem 0.85rem; font-size: var(--t-sm); }

  @media (max-width: 56rem) { .panels { grid-template-columns: 1fr; } }
  @media (max-width: 26rem) { dl div { grid-template-columns: 1fr; gap: 0; } }
</style>
