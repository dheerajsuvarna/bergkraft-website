---
import SectionHead from './SectionHead.astro';

// Abstract coordinate grid (0-90°E, 0-60°N). Only the two cities are plotted.
// No routes, borders, warehouses or offices are drawn, because none are claimed.
const W = 800, H = 520;
const x = (lon: number) => (lon / 90) * W;
const y = (lat: number) => ((60 - lat) / 60) * H;
const berlin = { x: x(13.4), y: y(52.52) };
const mangalore = { x: x(74.86), y: y(12.91) };
const meridians = [15, 30, 45, 60, 75];
const parallels = [15, 30, 45];

const parties = [
  { who: 'The buyer', role: 'Sets the requirement, approves the benchmark, contracts with the supplier and pays for the goods.' },
  { who: 'Bergkraft', role: 'Works for the buyer under a services agreement: evaluation, benchmarking, negotiation and coordination.' },
  { who: 'Indian suppliers', role: 'Mills, estates and exporters who produce, sell and ship the goods under their contract with the buyer.' },
  { who: 'Service providers', role: 'Independent inspection agencies, laboratories, forwarders and banks, appointed as agreed for each order.' },
];
---
<section class="section bg-botanical on-dark" id="locations">
  <div class="container grid">
    <div class="copy">
      <SectionHead index="09" label="India and Europe" title="Close to the buyer. <em>Close to the source.</em>">
        <p>
          International procurement requires more than a supplier contact. It requires local understanding,
          clear communication and commercial coordination.
        </p>
      </SectionHead>
      <p class="muted" data-reveal>
        Bergkraft works between Berlin, Germany and Mangalore, on the coast of Karnataka in southern India.
        Buyers deal with us in their own working day; suppliers deal with us in theirs.
      </p>
    </div>

    <figure class="map" data-reveal>
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Coordinate grid marking Berlin and Mangalore, joined by a single line">
        <g class="graticule">
          {meridians.map((m) => <line x1={x(m)} y1="0" x2={x(m)} y2={H} />)}
          {parallels.map((p) => <line x1="0" y1={y(p)} x2={W} y2={y(p)} />)}
        </g>
        <g class="ticks">
          {meridians.map((m) => <text x={x(m) + 6} y={H - 10}>{m}°E</text>)}
          {parallels.map((p) => <text x="8" y={y(p) - 8}>{p}°N</text>)}
        </g>
        <path class="arc" pathLength="1" d={`M${berlin.x} ${berlin.y} Q ${W * 0.62} ${H * 0.08} ${mangalore.x} ${mangalore.y}`} />
        <g class="city">
          <circle cx={berlin.x} cy={berlin.y} r="6" />
          <text x={berlin.x + 16} y={berlin.y + 30}>Berlin</text>
          <text class="coord" x={berlin.x + 16} y={berlin.y + 50}>52.52°N 13.40°E</text>
        </g>
        <g class="city">
          <circle cx={mangalore.x} cy={mangalore.y} r="6" />
          <text x={mangalore.x - 16} y={mangalore.y + 34} text-anchor="end">Mangalore</text>
          <text class="coord" x={mangalore.x - 16} y={mangalore.y + 54} text-anchor="end">12.91°N 74.86°E</text>
        </g>
      </svg>
    </figure>

    <dl class="parties">
      {parties.map((p, i) => (
        <div data-reveal style={`--delay:${0.08 * i}s`}>
          <dt>{p.who}</dt>
          <dd>{p.role}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .copy { grid-column: 1 / span 5; display: grid; align-content: start; }
  .copy :global(.head) { margin-bottom: var(--s-5); }
  .map { grid-column: 7 / -1; border: 1px solid var(--c-line-on-dark); }
  svg { width: 100%; }
  .graticule line { stroke: var(--c-line-on-dark); stroke-width: 1; }
  .ticks text { fill: var(--c-muted-on-dark); font-size: 11px; letter-spacing: 0.1em; opacity: 0.7; }
  .arc { fill: none; stroke: var(--c-brass-light); stroke-width: 1.5; stroke-dasharray: 1; stroke-dashoffset: 0; }
  :global(.js) .map .arc { stroke-dashoffset: 1; transition: stroke-dashoffset 2.2s var(--ease) 0.3s; }
  :global(.js) .map.is-visible .arc { stroke-dashoffset: 0; }
  .city circle { fill: var(--c-brass-light); }
  .city text { fill: var(--c-ivory); font-family: var(--f-serif); font-size: 26px; }
  .city .coord { font-family: var(--f-sans); font-size: 11px; letter-spacing: 0.12em; fill: var(--c-muted-on-dark); }

  .parties { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, 1fr); margin-top: var(--s-8); border-top: 1px solid var(--c-ivory); }
  .parties > div { padding: var(--s-5) var(--s-5) 0 0; }
  .parties > div + div { border-left: 1px solid var(--c-line-on-dark); padding-left: var(--s-5); }
  dt { font-family: var(--f-serif); font-size: 1.5rem; margin-bottom: var(--s-2); }
  .parties > div:nth-child(2) dt { color: var(--c-brass-light); font-style: italic; }
  dd { font-size: var(--t-sm); color: var(--c-muted-on-dark); }

  @media (max-width: 62rem) {
    .copy, .map { grid-column: 1 / -1; }
    .map { margin-top: var(--s-6); }
    .parties { grid-template-columns: repeat(2, 1fr); }
    .parties > div { padding-bottom: var(--s-5); }
    .parties > div:nth-child(3) { border-left: 0; padding-left: 0; }
    .parties > div:nth-child(n + 3) { border-top: 1px solid var(--c-line-on-dark); }
  }
  @media (max-width: 36rem) {
    .parties { grid-template-columns: 1fr; }
    .parties > div, .parties > div + div { border-left: 0; padding-left: 0; }
    .parties > div + div { border-top: 1px solid var(--c-line-on-dark); }
    .city text { font-size: 34px; }
    .city .coord, .ticks text { font-size: 16px; }
  }
</style>
