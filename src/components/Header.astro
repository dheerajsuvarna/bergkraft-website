---
import LangSwitch from './LangSwitch.astro';
import { t, path, type Lang } from '../i18n';
interface Props { lang: Lang; home?: boolean }
const { lang, home = false } = Astro.props;
const d = t(lang);
// On pages other than the homepage, anchors must point back to it.
const base = home ? '' : path(lang, '/');
---
<header class="site-header" data-header>
  <div class="container inner">
    <a class="wordmark" href={home ? '#top' : path(lang, '/')} aria-label={d.ui.home}>Bergkraft</a>

    <button class="toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="visually-hidden">{d.ui.menu}</span>
      <span class="bars" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="nav" aria-label={d.ui.primaryNav} data-nav>
      <ul role="list">
        {d.nav.map((item) => <li><a href={`${base}${item.href}`}>{item.label}</a></li>)}
      </ul>
      <div class="end">
        <LangSwitch lang={lang} />
        <a class="btn btn--primary btn--sm" href={`${base}#contact`} data-track="cta_header">{d.ui.cta}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 100; height: var(--header-h);
    background: var(--c-white);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .site-header[data-scrolled] { border-bottom-color: var(--c-line); }
  .inner { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: var(--s-5); }
  .wordmark { font-weight: 800; font-stretch: 75%; font-size: 1.9rem; letter-spacing: -0.01em; text-decoration: none; color: var(--c-indigo); }
  .nav { display: flex; align-items: center; gap: clamp(0.75rem, 1.6vw, 1.75rem); }
  .end { display: flex; align-items: center; gap: var(--s-4); }
  .nav ul { display: flex; gap: clamp(0.75rem, 1.5vw, 1.6rem); }
  .nav li a {
    font-size: var(--t-sm); font-weight: 600; text-decoration: none; padding-block: 0.5rem; position: relative;
  }
  .nav li a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0.1rem; height: 3px; background: var(--c-marigold);
    transform: scaleX(0); transform-origin: left; transition: transform var(--dur-fast) var(--ease);
  }
  .nav li a:hover::after, .nav li a[aria-current='true']::after { transform: scaleX(1); }
  .toggle { display: none; }

  @media (max-width: 74rem) {
    /* The menu only collapses when JavaScript is available to open it. */
    :global(.js) .toggle {
      display: grid; place-items: center; width: 3rem; height: 3rem; margin-right: -0.75rem;
      background: none; border: 0; cursor: pointer;
    }
    .bars, .bars::before, .bars::after {
      display: block; width: 1.5rem; height: 2.5px; background: var(--c-indigo); transition: transform var(--dur-fast) var(--ease);
    }
    .bars { position: relative; }
    .bars::before, .bars::after { content: ''; position: absolute; left: 0; }
    .bars::before { top: -6px; }
    .bars::after { top: 6px; }
    .toggle[aria-expanded='true'] .bars { background: transparent; }
    .toggle[aria-expanded='true'] .bars::before { transform: translateY(6px) rotate(45deg); }
    .toggle[aria-expanded='true'] .bars::after { transform: translateY(-6px) rotate(-45deg); }

    :global(.js) .nav {
      position: fixed; inset: var(--header-h) 0 0 0; background: var(--c-white);
      flex-direction: column; align-items: flex-start; justify-content: space-between;
      padding: var(--s-6) var(--gutter) var(--s-7); overflow-y: auto;
      visibility: hidden; opacity: 0; transform: translateY(-8px);
      transition: opacity var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease), visibility 0s linear var(--dur-fast);
    }
    :global(.js) .nav[data-open] { visibility: visible; opacity: 1; transform: none; transition-delay: 0s; }
    :global(.js) .nav ul { flex-direction: column; gap: 0; width: 100%; }
    :global(.js) .nav li { border-bottom: 1px solid var(--c-line); }
    :global(.js) .nav li a { display: block; font-weight: 800; font-stretch: 75%; font-size: 2rem; color: var(--c-indigo); padding-block: 0.8rem; }
    :global(.js) .nav li a::after { content: none; }
    :global(.js) .nav .end { width: 100%; flex-direction: column; align-items: stretch; gap: var(--s-4); margin-top: var(--s-6); }
    :global(.js) .nav .btn { width: 100%; justify-content: center; }

    /* Without JavaScript: a simple wrapping row. */
    :global(html:not(.js)) .site-header { height: auto; position: static; }
    :global(html:not(.js)) .inner, :global(html:not(.js)) .nav, :global(html:not(.js)) .nav ul { flex-wrap: wrap; padding-block: var(--s-2); }
  }
</style>
