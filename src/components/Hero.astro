---
import BagLabel from './BagLabel.astro';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<section class="hero" id="top">
  <div class="container grid">
    <div class="copy">
      <h1><span>{d.hero.h1a}</span> <span>{d.hero.h1b}</span></h1>
      <p class="lead">{d.hero.lead}</p>
      <div class="actions">
        <a class="btn btn--primary" href="#contact" data-track="cta_hero">{d.ui.cta}</a>
        <a class="btn" href="#what-we-do">{d.hero.secondary}</a>
      </div>
      <p class="pay">{d.hero.pay}</p>
    </div>
    <div class="visual">
      <BagLabel lang={lang} />
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(2rem, 5vw, 4.5rem) var(--s-section); }
  .grid { align-items: center; row-gap: var(--s-7); }
  .copy { grid-column: 1 / span 7; display: grid; gap: var(--s-5); justify-items: start; }
  .visual { grid-column: 8 / -1; }
  h1 span { display: block; }
  h1 span + span { color: var(--c-ink); }
  /* German words are longer: let them break instead of overflowing. */
  h1:lang(de) { font-size: clamp(2.5rem, 1.2rem + 5.4vw, 5.25rem); hyphens: auto; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-2); }
  .pay { font-weight: 700; font-stretch: 92%; border-left: 6px solid var(--c-marigold); padding-left: var(--s-3); }

  @media (max-width: 64rem) {
    .copy { grid-column: 1 / -1; }
    .visual { grid-column: 1 / -1; max-width: 26rem; }
  }
  @media (max-width: 30rem) {
    .actions { width: 100%; }
    .actions .btn { flex: 1 1 100%; }
  }
</style>
