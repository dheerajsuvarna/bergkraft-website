---
import { site } from '../data/site';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).about;
---
<section class="section" id="about">
  <div class="container grid">
    <div class="places">
      <h2>{d.h2}</h2>
      <div class="cities">
        {d.cities.map((c) => (
          <div>
            <h3>{c.name}</h3>
            <p class="muted">{c.text}</p>
          </div>
        ))}
      </div>
      <p class="muted small">{d.note}</p>
    </div>

    <div class="founder">
      {site.founderPhoto && <img src={site.founderPhoto} alt={`${site.founder}, ${d.photoAlt}`} width="800" height="1000" loading="lazy" decoding="async" />}
      <blockquote>
        {d.quote.map((q) => <p>{q}</p>)}
      </blockquote>
      <p class="who">
        <strong>{site.founder}</strong>
        {d.role}
      </p>
      {site.linkedinFounder && <a class="link" href={site.linkedinFounder} rel="noopener" data-track="linkedin_founder">{d.linkedin}</a>}
    </div>
  </div>
</section>

<style>
  .grid { row-gap: var(--s-7); align-items: start; }
  .places { grid-column: 1 / span 6; display: grid; gap: var(--s-6); }
  .cities { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-5); }
  .cities div { border-top: 3px solid var(--c-indigo); padding-top: var(--s-4); display: grid; gap: var(--s-2); align-content: start; }
  .founder { grid-column: 8 / -1; background: var(--c-tint); border-radius: 14px; padding: clamp(1.5rem, 3.5vw, 2.75rem); display: grid; gap: var(--s-5); justify-items: start; }
  .founder img { width: 9rem; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius); }
  blockquote { display: grid; gap: var(--s-4); font-size: var(--t-lg); line-height: 1.4; }
  .who strong { display: block; font-size: var(--t-h3); font-stretch: 88%; color: var(--c-indigo); }
  .who { font-size: var(--t-sm); color: var(--c-muted); }
  @media (max-width: 62rem) { .places, .founder { grid-column: 1 / -1; } }
  @media (max-width: 30rem) { .cities { grid-template-columns: 1fr; } }
</style>
