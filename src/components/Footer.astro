---
import LangSwitch from './LangSwitch.astro';
import { site } from '../data/site';
import { t, path, type Lang } from '../i18n';
interface Props { lang: Lang; home?: boolean }
const { lang, home = false } = Astro.props;
const d = t(lang);
const base = home ? '' : path(lang, '/');
const year = new Date().getFullYear();
---
<footer class="footer on-dark">
  <div class="container">
    <div class="grid cols">
      <div class="about">
        <p><strong>{site.legalName}</strong></p>
        <p class="muted">{d.footer.tagline}</p>
        <p class="muted">{d.footer.places}</p>
        <LangSwitch lang={lang} />
      </div>
      <nav aria-label={d.ui.footerNav}>
        <ul role="list">
          {d.nav.map((i) => <li><a class="link" href={`${base}${i.href}`}>{i.label}</a></li>)}
        </ul>
      </nav>
      <div>
        <ul role="list">
          <li><a class="link" href={`mailto:${site.email}`} data-track="contact_email">{site.email}</a></li>
          {site.phones.map((p) => <li><a class="link" href={p.href} rel="noopener" data-track="contact_whatsapp">{p.display}</a> <span class="muted small">{d.contact.phones[p.office]}</span></li>)}
          {site.linkedinCompany && <li><a class="link" href={site.linkedinCompany} rel="noopener" data-track="linkedin_company">LinkedIn</a></li>}
        </ul>
      </div>
    </div>

    <div class="legal">
      <p>© {year} {site.legalName}</p>
      <ul role="list">
        <li><a class="link" href={path(lang, '/impressum/')}>{d.footer.impressum}</a></li>
        <li><a class="link" href={path(lang, '/datenschutz/')}>{d.footer.privacy}</a></li>
        <li><a class="link" href={path(lang, '/cookies/')}>{d.footer.cookies}</a></li>
        <li><button type="button" class="link" data-consent-open>{d.footer.cookieSettings}</button></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--c-indigo-deep); padding-block: var(--s-8) var(--s-6); }
  .cols { row-gap: var(--s-6); }
  .cols > * { grid-column: span 4; }
  .about { display: grid; gap: var(--s-3); align-content: start; justify-items: start; max-width: 24rem; }
  .about strong { font-size: var(--t-h3); font-weight: 800; font-stretch: 75%; }
  li { padding-block: 0.3rem; }
  nav ul { columns: 2; }
  .small { font-size: var(--t-xs); }
  .legal {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-3) var(--s-5);
    margin-top: var(--s-8); padding-top: var(--s-5); border-top: 2px solid var(--c-line-on-dark); font-size: var(--t-sm);
  }
  .legal ul { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); }
  .legal li { padding: 0; }
  button.link { border: 0; cursor: pointer; padding: 0; color: inherit; background: transparent; }
  @media (max-width: 52rem) { .cols > * { grid-column: 1 / -1; } }
</style>
