---
import Category from './Category.astro';
import { images } from '../data/site';

const groups = [
  {
    name: 'Basmati',
    items: [
      { t: '1121 Sella', d: 'Extra-long grain, parboiled. Widely used in food service and for markets that prefer a firm, separate grain.' },
      { t: '1121 Raw', d: 'Extra-long grain, milled without parboiling. Common in retail and private-label packs.' },
      { t: '1509 Basmati', d: 'Long-grain variety, available raw, steamed or sella, often considered as a commercial alternative to 1121.' },
    ],
  },
  {
    name: 'Non-Basmati',
    items: [
      { t: 'Sona Masoori', d: 'Medium-grain rice from southern India, bought largely for ethnic retail and wholesale.' },
      { t: 'IR-64', d: 'Long-grain non-Basmati, raw or parboiled, traded in volume for wholesale and processing.' },
    ],
  },
];
const specs = ['Grain length', 'Broken percentage', 'Moisture', 'Foreign matter', 'Processing', 'Crop year', 'Packaging', 'Quantity', 'Destination requirements'];
---
<Category
  id="rice"
  index="05"
  label="Rice sourcing"
  title="Indian rice, <em>specified before it is priced.</em>"
  intro="Two offers for “1121 Basmati” can differ in grain length, brokens, age and packing. We help you define the specification first, then source and compare against it."
  groups={groups}
  specs={specs}
  image={images.riceDetail}
  imageAlt="Long-grain rice kernels photographed close up"
/>
