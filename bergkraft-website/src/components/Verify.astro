---
// Marks information that Bergkraft must confirm before the page is published.
// Search the project for "<Verify" to find every open item.
---
<aside class="verify">
  <strong>To verify before publication</strong>
  <slot />
</aside>

<style>
  .verify {
    border: 1px dashed var(--c-brass-deep); background: var(--c-paper);
    padding: var(--s-4); margin-block: var(--s-4); font-size: var(--t-sm); display: grid; gap: var(--s-2);
  }
  strong { font-size: var(--t-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--c-brass-deep); }
  .verify :global(ul) { margin: 0; padding-left: 1.2em; }
</style>
