---
// Shared section heading: small numbered label, serif title, optional lead text.
interface Props {
  index: string;
  label: string;
  /** Title may contain <em> for the italic accent. */
  title: string;
  wide?: boolean;
}
const { index, label, title, wide = false } = Astro.props;
---
<header class:list={['head', { 'head--wide': wide }]} data-reveal>
  <p class="eyebrow"><span>{index}</span> {label}</p>
  <h2 set:html={title} />
  {Astro.slots.has('default') && <div class="lead"><slot /></div>}
</header>

<style>
  .head { display: grid; gap: var(--s-5); max-width: 50rem; margin-bottom: clamp(2.5rem, 6vw, 5rem); }
  .head--wide { max-width: 62rem; }
  .eyebrow span { font-variant-numeric: tabular-nums; }
</style>
