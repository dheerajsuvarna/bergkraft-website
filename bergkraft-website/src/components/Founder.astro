---
import Art from './Art.astro';
import { site, images } from '../data/site';
---
<section class="section" id="founder">
  <div class="container grid">
    <div class="photo" data-reveal>
      <Art image={images.founder} alt={images.founder.temporary ? 'Placeholder for a portrait of Dheeraj Suvarna' : 'Dheeraj Suvarna, founder of Bergkraft'} />
    </div>

    <div class="text">
      <p class="eyebrow" data-reveal><span>10</span> Founder</p>
      <blockquote data-reveal>
        <p>
          Bergkraft was founded around a simple idea: international buyers deserve an independent procurement
          partner in India who works for their interests.
        </p>
      </blockquote>
      <p class="lead" data-reveal>
        My background in product management and supply chain technology has shaped the way I approach
        procurement: clear requirements, structured decisions, transparent commercial terms and accountability.
      </p>
      <div class="sig" data-reveal>
        <h2 class="name">{site.founder}</h2>
        <p class="muted">
          Founder, {site.legalName}. From Mangalore, India, and based in Germany. Background in product
          management, supply chain and trade finance software.
        </p>
        {site.linkedinFounder
          ? <a class="link" href={site.linkedinFounder} rel="noopener">LinkedIn profile</a>
          : <span class="pending">LinkedIn profile: link to be added</span>}
      </div>
    </div>
  </div>
</section>

<style>
  .photo { grid-column: 2 / span 4; }
  .photo :global(.art) { aspect-ratio: 4 / 5; }
  .text { grid-column: 7 / -1; display: grid; gap: var(--s-6); align-content: center; }
  blockquote p {
    font-family: var(--f-serif); font-weight: 340; font-style: italic;
    font-size: clamp(1.6rem, 1.1rem + 2.2vw, 2.9rem); line-height: 1.18; letter-spacing: -0.01em;
  }
  .sig { display: grid; gap: var(--s-2); justify-items: start; padding-top: var(--s-5); border-top: 1px solid var(--c-line); }
  .name { font-size: var(--t-h3); }
  .sig p { font-size: var(--t-sm); max-width: 34em; }
  .pending { font-size: var(--t-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-muted); border: 1px dashed var(--c-line); padding: 0.25rem 0.6rem; }
  @media (max-width: 62rem) {
    .photo { grid-column: 1 / span 6; margin-bottom: var(--s-6); }
    .text { grid-column: 1 / -1; }
  }
  @media (max-width: 36rem) { .photo { grid-column: 1 / span 9; } }
</style>
